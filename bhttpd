#!/usr/bin/env bash

#
# echo is also return in bash functions lol
#

set -euo pipefail

LOG_LEVEL=`echo ${LOG_LEVEL:-warning} | tr A-Z a-z`
test $LOG_LEVEL == "debug" && set -x

# Configuration
PORT=8080
WWWROOT=htdocs
RUNDIR=run

debug() {
    echo "$@" 1>&2
}

# URL decoding helper
urldecode() {
    local url_encoded="${1//+/ }"
    printf '%b' "${url_encoded//%/\\x}"
}

# BASP (Bourne-Again Server Pages): execute <% shell %> blocks inline,
# splicing their stdout into the surrounding document.
render_basp() {
    local content rest before code out=""
    content="$(cat "$1")"
    rest="$content"

    if [[ "$rest" != *'<%'* ]]; then
        printf '%s' "$rest"
        return
    fi

    while [[ "$rest" == *'<%'* ]]; do
        before="${rest%%<%*}"
        rest="${rest#*<%}"
        if [[ "$rest" != *'%>'* ]]; then
            # no closing tag; leave it as-is
            out+="$before<%$rest"
            rest=""
            break
        fi
        code="${rest%%%>*}"
        rest="${rest#*%>}"
        out+="$before$(eval "$code" 2>&1)"
    done
    out+="$rest"

    printf '%s' "$out"
}

# HTTP Response Helpers
respond() {
    local status="$1"
    local content_type="${2:-text/plain}"
    local content="$3"
    local content_length=$(($(echo -n "$content" | wc -c)+1))
    echo -e "HTTP/1.1 $status\r\nContent-Type: $content_type\r\nContent-Length: $content_length\r\n\r\n$content"
}

parse_headers() {
    declare -g -A HEADERS
    local prev_header=""
    
    while read -r line; do
        line="${line%$'\r'}"
        # Break at empty line (end of headers)
        test -z "$line" && break
        
        # Handle header continuations (lines starting with whitespace)
        if [[ $line =~ ^[[:space:]] ]]; then
            # Append to previous header if exists
            if [[ -n "$prev_header" ]]; then
                HEADERS[$prev_header]+=" ${line## }"
            fi
            continue
        fi
        
        # Parse normal headers
        if [[ $line =~ ^([^:]+):\ (.*)$ ]]; then
            local name="${BASH_REMATCH[1],,}"  # lowercase header name
            local value="${BASH_REMATCH[2]}"
            HEADERS[$name]="$value"
            prev_header="$name"
        fi
    done
}

handle_request() {
    local line="$1"
    if [[ $line =~ ^(GET|POST|PUT|DELETE|PATCH)\ /(.*)\ HTTP.*$ ]]; then
        declare -g METHOD=${BASH_REMATCH[1]}
        declare -g REQUEST_PATH=$WWWROOT/$(urldecode "${BASH_REMATCH[2]}")
        parse_headers

        case $METHOD in
            GET)
                if test -f "$REQUEST_PATH"; then
                    respond "200 OK" "$(file -b --mime-type "$REQUEST_PATH")" "$(render_basp "$REQUEST_PATH")"
                else
                    respond "404 Not Found" "" "404 Not Found"
                fi
                ;;
            POST)
                local content_length=${HEADERS[content-length]:-0}
                local post_data=""
                test $content_length -gt 0 && read -n $content_length post_data
                
                while IFS= read -r line; do 
                    # free persistent sessions!
                    export "$line"
                done <<< "$post_data"
                
                if test -x "$REQUEST_PATH"; then
                    respond "200 OK" "" "$("$REQUEST_PATH")"
                else
                    respond "404 Not Found" "" "Script not found or not executable" 
                fi
                ;;
            PUT)
                content_length=${HEADERS[content-length]:-0}
                
                if test $content_length -gt 0; then
                    dd bs=$content_length count=1 of="$REQUEST_PATH"
                    respond "201 Created" "" "File created"
                else
                    respond "411 Length Required" "" "Content-Length required"
                fi
                ;;
            PATCH)
                local content_length=${HEADERS[content-length]:-0}
                local patch_data=""
                
                if ! test -f "$REQUEST_PATH"; then
                    respond "404 Not Found" "" "Target file not found"
                    return
                fi
                
                if test $content_length -gt 0; then
                    read -n $content_length patch_data
                    if echo "$patch_data" | patch "$REQUEST_PATH" -; then
                        respond "200 OK" "" "Patch applied"
                    else
                        respond "400 Bad Request" "" "Patch failed to apply"
                    fi
                else
                    respond "411 Length Required" "" "Content-Length required"
                fi
                ;;
            DELETE)
                if test -f "$REQUEST_PATH"; then
                    if rm "$REQUEST_PATH"; then
                        respond "200 OK" "" "File deleted"
                    else
                        respond "500 Server Error" "" "Could not delete $REQUEST_PATH"
                    fi
                else
                    respond "404 Not Found" "" "404 Not Found"
                fi
                ;;
            *)
                respond "501 Not Implemented" "" "Method not implemented"
                ;;
        esac
    fi
}

REQUEST=$RUNDIR/request RESPONSE=$RUNDIR/response
mkfifo $REQUEST $RESPONSE

cleanup() {
    exec 4<&- 2>/dev/null
    rm -f $REQUEST $RESPONSE
    set +x
    exit
}

trap cleanup EXIT SIGINT

# Hold a read end of $REQUEST open for the life of the server. Opening a
# fifo for write alone blocks until a reader shows up, and nc needs to open
# $REQUEST for writing (its stdout, the bytes it received from the client)
# fresh on every connection below -- without a standing reader here, that
# open would deadlock.
exec 4<>$REQUEST

# One nc per connection, waited out fully before the next is spawned. A
# single long-lived `nc -lk` reads $RESPONSE independently of whether a
# client is connected, so a response written while nc sat between
# connections got buffered and flushed to whichever client connected
# *next* instead of the one it was meant for -- a permanent one-request
# lag. Spawning fresh per connection removes that stale window entirely.
while true; do
    # Subshell so a bad request (set -e tripping on something like a
    # malformed body) only kills this one connection's handling instead of
    # the whole server -- same isolation the old design got for free from
    # its request handler living in a backgrounded loop.
    (
        # Same deadlock-avoidance trick as fd 4 above, but this one we
        # deliberately close once we're done writing: nc waits for stdin
        # EOF (all writers of $RESPONSE closed) as well as the socket
        # closing before it exits, so a placeholder held open forever
        # would leave nc -- and the port -- stuck for good after the very
        # first request.
        exec 3<>$RESPONSE
        nc -l $PORT <$RESPONSE >$REQUEST &
        NC_PID=$!
        read line <$REQUEST  # blocks until a client connects
        # parse_headers and the POST/PUT/PATCH body reads use bash's
        # default stdin with no redirection of their own -- without
        # pointing it at $REQUEST here, header/body lines are left unread
        # in the fifo and get misread as the *next* request's request
        # line.
        [[ $line =~ ^(GET|POST|PUT|DELETE|PATCH)\ /.*\ HTTP.*$ ]] && handle_request "$line" <$REQUEST >$RESPONSE
        exec 3<&-
        wait $NC_PID 2>/dev/null
    )
done
